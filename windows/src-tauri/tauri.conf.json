{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kept for Gig Workers",
  "version": "1.1.0",
  "identifier": "com.desertcircuitapps.kept",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kept for Gig Workers",
        "url": "https://keptforgigworkers.com/?app=windows",
        "width": 1200,
        "height": 820,
